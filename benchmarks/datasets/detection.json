{
  "version": "1.1.0",
  "description": "Labeled security benchmark for Nullsec-1 (RC2). expected_categories is the set Nullsec-1 should detect; expected_production_ready is the Safety-Layer-enforced ground truth. Covers all 16 taxonomy categories with unsafe, clean, and mixed multi-vulnerability cases (MCP/tool abuse, Web3/wallet, Next.js/Supabase/Vercel/Stripe/Auth). owasp tags map web cases to OWASP Top 10 2021 / OWASP LLM Top 10 2025 where applicable. Authored to be distinct from the training corpus.",
  "cases": [
    {
      "id": "secret-aws-key",
      "filename": "s.py",
      "lang": "python",
      "code": "AWS_KEY='AKIAIOSFODNN7EXAMPLE'\nAWS_SECRET='wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY'\n",
      "expected_categories": [
        "EXPOSED_SECRET"
      ],
      "expected_min_severity": "CRITICAL",
      "expected_production_ready": false,
      "owasp": "A07:2021-Identification and Authentication Failures"
    },
    {
