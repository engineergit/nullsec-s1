{
  "name": "@s1-clm/s1",
  "version": "0.1.6",
  "description": "Nullsec S1 security scanner CLI",
  "homepage": "https://s1.trynullsec.com",
  "license": "MIT",
  "keywords": [
    "nullsec",
    "security",
    "scanner",
    "cli",
    "ai",
    "code-security"
  ],
  "type": "module",
  "bin": {
    "s1": "./dist/cli.js",
    "nullsec-s1": "./dist/cli.js"
  },
  "files": [
    "dist",
    "runtime",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node ./scripts/fix-bin.js && node ./scripts/copy-runtime.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=18.17"
  }
}
